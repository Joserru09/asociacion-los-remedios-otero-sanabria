---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import NoticiaItem from '../components/NoticiaItem.astro';
import ProductoCard from '../components/ProductoCard.astro';
import Redes from '../components/Redes.astro';
import { site, pagos, redesActivas } from '../site.config';
import { galeria } from '../data/galeria';
import { euros, fechaLarga } from '../utils/fecha';
import hero from '../assets/hero.jpg';

const noticias = (await getCollection('noticias')).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime(),
);
const destacada = noticias.find((n) => n.data.destacada) ?? noticias[0];
const ultimas = noticias.slice(0, 3);

const productos = (await getCollection('productos'))
  .filter((p) => !p.data.agotado)
  .sort((a, b) => a.data.orden - b.data.orden)
  .slice(0, 3);

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/galeria/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const muestra = galeria.slice(0, 3).map((g) => ({
  ...g,
  src: fotos[`../assets/galeria/${g.fichero}`].default,
}));
---

<Base titulo={site.nombre}>
  <section class="hero">
    <Image
      src={hero}
      alt=""
      width={1920}
      height={1080}
      loading="eager"
      fetchpriority="high"
      class="hero-fondo"
    />
    <div class="hero-velo" aria-hidden="true"></div>
    <div class="contenedor hero-contenido">
      <p class="hero-lugar">{site.comarca}</p>
      <h1>Otero de Sanabria</h1>
      <p class="hero-sub">
        La asociación cultural del pueblo. Organizamos las fiestas, cuidamos lo común y contamos
        aquí lo que pasa, para que te enteres aunque vivas lejos.
      </p>
      <div class="hero-acciones">
        <a class="btn btn-primario" href="/novedades/">Ver novedades</a>
        <a class="btn btn-secundario" href="/socios/">Hazte socio</a>
      </div>
    </div>
  </section>

  {destacada && (
    <section class="destacada">
      <div class="contenedor">
        <a href={`/novedades/${destacada.id}/`} class="destacada-enlace">
          <span class="meta">Lo último · {fechaLarga(destacada.data.fecha)}</span>
          <span class="destacada-titulo">{destacada.data.titulo}</span>
        </a>
      </div>
    </section>
  )}

  <section class="seccion">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2>Tablón de novedades</h2>
        <a href="/novedades/">Todas las novedades</a>
      </div>
      <div class="lista">
        {ultimas.map((n) => <NoticiaItem noticia={n} />)}
      </div>
    </div>
  </section>

  <section class="seccion seccion-suave">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2>La tienda del pueblo</h2>
        <a href="/tienda/">Ver toda la tienda</a>
      </div>
      <p class="intro">
        Camisetas, sudaderas y pegatinas de Otero. Todo lo recaudado va a las actividades de la asociación.
      </p>
      <div class="rejilla-productos">
        {productos.map((p) => <ProductoCard producto={p} compacto />)}
      </div>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor">
      <div class="cabecera-seccion">
        <h2>Fotos</h2>
        <a href="/galeria/">Ver la galería</a>
      </div>
      <div class="mosaico">
        {muestra.map((f) => (
          <a href="/galeria/" class="mosaico-item">
            <Image src={f.src} alt={f.pie} width={900} height={700} loading="lazy" />
            <span class="pie-foto">{f.pie}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion seccion-suave apoya">
    <div class="contenedor apoya-grid">
      <div class="panel">
        <h2>Hazte socio</h2>
        <p>
          Por {euros(pagos.cuotaSocioEuros)} al año mantienes vivas las fiestas y las actividades, y decides en la asamblea.
        </p>
        <a class="btn btn-primario" href="/socios/">Cómo hacerse socio</a>
      </div>
      <div class="panel">
        <h2>Echa una mano</h2>
        <p>Una donación puntual, por Bizum, tarjeta o transferencia, para lo que haga falta este año.</p>
        <a class="btn btn-secundario" href="/donaciones/">Donar</a>
      </div>
      <div class="panel">
        <h2>Síguenos</h2>
        {redesActivas().length > 0 ? (
          <>
            <p>Las fotos del día a día y los avisos rápidos están en las redes del pueblo.</p>
            <Redes />
          </>
        ) : (
          <p>Escríbenos a <a href={`mailto:${site.email}`}>{site.email}</a> y te avisamos de todo.</p>
        )}
      </div>
    </div>
  </section>
</Base>

<style>
  /* Portada: foto a sangre con velo oscuro y titular serif encima */
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: min(78vh, 44rem);
    overflow: hidden;
  }

  .hero-fondo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-velo {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(18, 22, 30, 0.55) 0%, rgba(18, 22, 30, 0.25) 40%, rgba(18, 22, 30, 0.92) 100%),
      linear-gradient(to top, var(--fondo) 0%, transparent 30%);
  }

  .hero-contenido {
    position: relative;
    padding-block: 4rem 3.5rem;
  }

  .hero-lugar {
    color: var(--oro-claro);
    font-size: var(--t-sm);
    letter-spacing: 0.04em;
    margin-bottom: 0.75rem;
  }

  .hero h1 {
    font-size: var(--t-hero);
    margin-bottom: 1rem;
  }

  .hero-sub {
    font-size: var(--t-md);
    max-width: 44ch;
    color: var(--texto);
    margin-bottom: 1.75rem;
  }

  .hero-acciones {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Franja de lo último */
  .destacada {
    border-bottom: 1px solid var(--linea);
  }

  .destacada-enlace {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    flex-wrap: wrap;
    padding-block: 1.1rem;
    text-decoration: none;
  }

  .destacada-titulo {
    color: var(--tinta);
    font-weight: 600;
  }

  .destacada-enlace:hover .destacada-titulo {
    color: var(--oro-claro);
  }

  /* Secciones */
  .intro {
    max-width: 52ch;
    color: var(--texto-suave);
    margin-top: -1rem;
    margin-bottom: 2rem;
  }

  .rejilla-productos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .mosaico {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .mosaico-item {
    position: relative;
    display: block;
    border-radius: var(--radio);
    overflow: hidden;
    border: 1px solid var(--linea);
    aspect-ratio: 4 / 3;
  }

  .mosaico-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pie-foto {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.5rem 1rem 0.75rem;
    background: linear-gradient(to top, rgba(13, 17, 23, 0.85), transparent);
    color: var(--texto);
    font-size: var(--t-sm);
  }

  /* Apoya */
  .apoya-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .panel {
    display: flex;
    flex-direction: column;
  }

  .panel p {
    flex: 1;
    color: var(--texto-suave);
  }

  .panel .btn {
    align-self: flex-start;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 70vh;
    }

    .rejilla-productos,
    .apoya-grid,
    .mosaico {
      grid-template-columns: 1fr;
    }

    .mosaico-item {
      aspect-ratio: 16 / 10;
    }
  }
</style>
