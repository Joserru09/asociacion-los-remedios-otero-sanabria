---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Portada from '../components/Portada.astro';
import ProductoCard from '../components/ProductoCard.astro';
import { site } from '../site.config';

const productos = (await getCollection('productos')).sort((a, b) => a.data.orden - b.data.orden);
const conDescripcion = await Promise.all(
  productos.map(async (p) => ({ producto: p, Content: (await render(p)).Content })),
);
---

<Base titulo="Tienda" descripcion="Camisetas, sudaderas, pegatinas y más de Otero de Sanabria. Lo recaudado va a la asociación.">
  <Portada
    titulo="La tienda del pueblo"
    entradilla="Cada camiseta paga un poco de la orquesta, la paella o el arreglo del lavadero. Y queda bien."
  />
  <section class="seccion tienda">
    <div class="contenedor">
      <div class="rejilla">
        {conDescripcion.map(({ producto, Content }) => (
          <ProductoCard producto={producto}>
            <Content />
          </ProductoCard>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion seccion-suave">
    <div class="contenedor como">
      <div>
        <h2>Cómo funciona</h2>
        <p>
          Al pulsar «Comprar» pasas a una página de pago segura de Stripe donde eliges la talla, pones tu dirección y pagas con tarjeta, Apple Pay o Google Pay. Nosotros recibimos el pedido y te lo mandamos o te lo guardamos para las fiestas.
        </p>
      </div>
      <div>
        <h2>Recogida en el pueblo</h2>
        <p>
          Si estás en Otero o vas a venir pronto, escríbenos a <a href={`mailto:${site.email}`}>{site.email}</a> y te lo reservamos sin gastos de envío. También puedes pagar por Bizum en mano.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .tienda {
    padding-top: 1rem;
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem 2rem;
  }

  .como {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
  }

  .como p {
    color: var(--texto-suave);
    margin: 0;
  }

  @media (max-width: 900px) {
    .rejilla {
      grid-template-columns: repeat(2, 1fr);
    }
    .como {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .rejilla {
      grid-template-columns: 1fr;
    }
  }
</style>
