---
import Base from '../layouts/Base.astro';
import Portada from '../components/Portada.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import Redes from '../components/Redes.astro';
import Mapa from '../components/Mapa.astro';
import Icono from '../components/Icono.astro';
import { site, redesActivas, whatsappActivo } from '../site.config';

const canal = whatsappActivo();

const motivos = [
  { asunto: 'Alta de socio', texto: 'Quiero hacerme socio de la asociación.' },
  { asunto: 'Tienda', texto: 'Una pregunta sobre un pedido o una reserva.' },
  { asunto: 'Fotos', texto: 'Tengo fotos del pueblo para la galería.' },
  { asunto: 'Una idea', texto: 'Se me ocurre una actividad para el pueblo.' },
];
---

<Base
  titulo="Contacto"
  descripcion={`Cómo ponerse en contacto con la ${site.nombreLargo} de ${site.pueblo}: correo, teléfono, redes y canal de WhatsApp.`}
>
  <Portada
    rotulo="Hablemos"
    titulo="Contacto"
    entradilla="Escríbenos para lo que sea: hacerte socio, una duda de la tienda, mandarnos fotos o proponer algo para el pueblo. Contestamos siempre, aunque a veces tardemos unos días."
  />

  <section class="seccion">
    <div class="contenedor dos">
      <div>
        <TituloSeccion titulo="Dónde estamos" alineacion="izquierda" />
        <ul class="datos">
          <li>
            <span class="icono"><Icono nombre="sobre" tamano={19} /></span>
            <div>
              <span class="etiqueta">Correo</span>
              <a href={`mailto:${site.email}`}>{site.email}</a>
            </div>
          </li>
          <li>
            <span class="icono"><Icono nombre="telefono" tamano={19} /></span>
            <div>
              <span class="etiqueta">Teléfono</span>
              <a href={`tel:${site.telefonoEnlace}`}>{site.telefono}</a>
              <p class="apunte">También por WhatsApp y Bizum.</p>
            </div>
          </li>
          <li>
            <span class="icono"><Icono nombre="pin" tamano={19} /></span>
            <div>
              <span class="etiqueta">Local de la asociación</span>
              <p class="direccion">
                {site.direccion}<br />
                {site.codigoPostal} {site.provincia}
              </p>
              <p class="apunte">
                En la comarca de Sanabria, al noroeste de la provincia. Abrimos el local los fines de semana de
                verano y en fiestas.
              </p>
            </div>
          </li>
        </ul>

        {
          redesActivas().length > 0 && (
            <div class="redes-bloque">
              <span class="etiqueta">Redes</span>
              <Redes class="redes-contacto" />
            </div>
          )
        }
      </div>

      <aside class="lateral">
        <div class="mapa-caja panel-marco">
          <Mapa />
          <p class="mapa-pie">{site.pueblo}, {site.comarca}</p>
        </div>

        {
          canal && (
            <div class="canal panel">
              <span class="circulo">
                <Icono nombre="whatsapp" tamano={22} />
              </span>
              <h2>Canal de WhatsApp</h2>
              <p>Avisos, actividades y novedades. Es un canal de difusión: solo publicamos nosotros.</p>
              <a class="btn btn-verde" href={canal} target="_blank" rel="noopener">
                <Icono nombre="whatsapp" tamano={15} />
                Unirme al canal
              </a>
            </div>
          )
        }
      </aside>
    </div>
  </section>

  <section class="seccion seccion-crema">
    <div class="contenedor">
      <TituloSeccion
        titulo="Escríbenos"
        entradilla="Elige el motivo y se abre tu correo con el asunto puesto. Si prefieres escribir a mano, el correo es el de arriba."
      />
      <div class="rejilla motivos">
        {
          motivos.map((m) => (
            <a class="motivo" href={`mailto:${site.email}?subject=${encodeURIComponent(m.asunto)}`}>
              <span class="motivo-asunto">{m.asunto}</span>
              <span class="motivo-texto">{m.texto}</span>
              <span class="enlace-flecha">Escribir</span>
            </a>
          ))
        }
      </div>
      <p class="legal">
        Al escribirnos, tus datos se usan solo para responderte y, si te haces socio, para gestionar el alta.
        Puedes consultar los detalles en la <a href="/privacidad/">política de privacidad</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .dos {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(16rem, 1fr);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  .datos {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .datos li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    align-items: start;
  }

  .icono {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--verde-claro);
    background: var(--papel);
    color: var(--verde-medio);
  }

  .etiqueta {
    display: block;
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tinta-suave);
    margin-bottom: 0.25rem;
  }

  .datos a {
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 600;
    text-decoration: none;
  }

  .direccion {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--tinta);
    line-height: 1.35;
  }

  .apunte {
    margin: 0.35rem 0 0;
    font-size: var(--t-sm);
    color: var(--tinta-suave);
    max-width: 44ch;
  }

  .redes-bloque {
    padding-top: 1.75rem;
    border-top: 1px solid var(--linea);
  }

  .redes-bloque .etiqueta {
    margin-bottom: 0.85rem;
  }

  .lateral {
    display: grid;
    gap: 1.5rem;
  }

  .mapa-caja {
    color: var(--verde-medio);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
  }

  .mapa-pie {
    margin: 0;
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tinta-suave);
  }

  .canal {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: var(--papel);
  }

  .circulo {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    margin-bottom: 0.9rem;
  }

  .canal h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .canal p {
    margin: 0 0 1.25rem;
    color: var(--tinta-media);
    font-size: var(--t-sm);
  }

  .motivos {
    margin-bottom: 2rem;
  }

  .motivo {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    height: 100%;
    padding: 1.25rem 1.35rem;
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    text-decoration: none;
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .motivo:hover {
    border-color: var(--verde-claro);
    transform: translateY(-2px);
  }

  .motivo-asunto {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--tinta);
  }

  .motivo-texto {
    flex: 1;
    color: var(--tinta-media);
    font-size: var(--t-sm);
  }

  .legal {
    max-width: 60ch;
    font-size: var(--t-sm);
    color: var(--tinta-suave);
    margin: 0;
  }

  @media (max-width: 900px) {
    .dos {
      grid-template-columns: 1fr;
    }
  }
</style>
