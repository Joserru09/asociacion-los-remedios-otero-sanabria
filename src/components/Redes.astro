---
import Icono from './Icono.astro';
import { redesActivas } from '../site.config';

interface Props {
  /** "color" pinta cada red con su color; "sobrio" las deja en verde. */
  estilo?: 'color' | 'sobrio';
  class?: string;
}
const { estilo = 'color', class: clase = '' } = Astro.props;

const etiquetas: Record<string, string> = {
  facebook: 'Facebook',
  instagram: 'Instagram',
  youtube: 'YouTube',
  tiktok: 'TikTok',
};

const activas = redesActivas();
---

{
  activas.length > 0 && (
    <ul class:list={['redes', estilo, clase]}>
      {activas.map(([clave, url]) => (
        <li>
          <a
            href={url}
            target="_blank"
            rel="noopener"
            class={`red ${clave}`}
            aria-label={`${etiquetas[clave]} de la asociación`}
            title={etiquetas[clave]}
          >
            <Icono nombre={clave as 'facebook'} tamano={20} />
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .redes {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .red {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    color: #fff;
    text-decoration: none;
    transition: transform 180ms ease, filter 180ms ease;
  }

  .red:hover {
    transform: translateY(-2px);
    filter: brightness(1.08);
    color: #fff;
  }

  .color .facebook {
    background: #1877f2;
  }

  .color .instagram {
    background: radial-gradient(circle at 30% 108%, #fdf497 0%, #fd5949 45%, #d6249f 60%, #285aeb 90%);
  }

  .color .youtube {
    background: #ff0000;
  }

  .color .tiktok {
    background: #111014;
  }

  .sobrio .red {
    background: transparent;
    border: 1px solid var(--linea);
    color: var(--verde);
  }

  .sobrio .red:hover {
    background: var(--verde);
    border-color: var(--verde);
    color: #fff;
  }
</style>
