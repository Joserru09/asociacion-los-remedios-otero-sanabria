---
import Marca from './Marca.astro';
import Mapa from './Mapa.astro';
import Icono from './Icono.astro';
import { site, menuPie, menuLegal } from '../site.config';

const año = new Date().getFullYear();
---

<footer class="pie">
  <div class="contenedor rejilla-pie">
    <div class="col-marca">
      <Marca disposicion="columna" tono="claro" emblema={72} />
    </div>

    <div>
      <h2 class="titulo-col">Contacto</h2>
      <ul class="datos">
        <li>
          <Icono nombre="pin" tamano={16} />
          <span>
            {site.direccion}<br />
            {site.codigoPostal} {site.provincia}
          </span>
        </li>
        <li>
          <Icono nombre="sobre" tamano={16} />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <Icono nombre="telefono" tamano={16} />
          <a href={`tel:${site.telefonoEnlace}`}>{site.telefono}</a>
        </li>
      </ul>
    </div>

    <nav aria-label="Pie de página">
      <h2 class="titulo-col">Enlaces</h2>
      <ul class="enlaces">
        {menuPie.map((m) => (
          <li>
            <a href={m.href}>{m.label}</a>
          </li>
        ))}
        <li><a href="/socios/">Hazte socio</a></li>
        <li><a href="/rss.xml">Noticias por RSS</a></li>
      </ul>
    </nav>

    <div class="col-frase">
      <p class="frase">
        «{site.frase}»
        <Icono nombre="corazon" tamano={14} class="corazon" />
      </p>
      <Mapa />
    </div>
  </div>

  <div class="franja-legal">
    <div class="contenedor legal">
      <p>© {site.fundacion}–{año} {site.nombreLargo} · {site.pueblo} · Todos los derechos reservados</p>
      <ul>
        {menuLegal.map((m) => (
          <li>
            <a href={m.href}>{m.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .pie {
    background: var(--verde);
    color: var(--sobre-verde-suave);
    margin-top: auto;
  }

  .rejilla-pie {
    display: grid;
    grid-template-columns: 1.1fr 1fr 0.85fr 1.2fr;
    gap: clamp(1.75rem, 4vw, 3.5rem);
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
    align-items: start;
  }

  .col-marca {
    display: flex;
    justify-content: center;
    padding-top: 0.25rem;
  }

  .titulo-col {
    font-family: var(--sans);
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sobre-verde);
    margin: 0 0 1.15rem;
  }

  .datos,
  .enlaces {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
    font-size: var(--t-sm);
  }

  .datos li {
    display: grid;
    grid-template-columns: 1.2rem 1fr;
    gap: 0.7rem;
    align-items: start;
    line-height: 1.5;
  }

  .datos :global(svg) {
    color: var(--sobre-verde-suave);
    margin-top: 0.15rem;
  }

  .pie a {
    color: var(--sobre-verde-suave);
    text-decoration: none;
  }

  .pie a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .col-frase {
    color: var(--sobre-verde-suave);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.25rem;
    text-align: right;
  }

  .frase {
    font-family: var(--mano);
    font-size: 1.7rem;
    line-height: 1.35;
    color: var(--sobre-verde);
    margin: 0;
    max-width: 15ch;
  }

  .frase :global(.corazon) {
    display: inline-block;
    color: var(--terracota);
    vertical-align: middle;
    margin-left: 0.2rem;
  }

  .franja-legal {
    border-top: 1px solid rgba(238, 233, 218, 0.16);
  }

  .legal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    padding-block: 1.15rem;
    font-size: var(--t-xs);
  }

  .legal p {
    margin: 0;
  }

  .legal ul {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .legal a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: rgba(238, 233, 218, 0.35);
  }

  @media (max-width: 1000px) {
    .rejilla-pie {
      grid-template-columns: repeat(2, 1fr);
    }

    .col-marca {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }

    .col-frase {
      align-items: flex-start;
      text-align: left;
    }
  }

  @media (max-width: 560px) {
    .rejilla-pie {
      grid-template-columns: 1fr;
    }

    .col-marca {
      justify-content: center;
      text-align: center;
    }

    .col-frase {
      align-items: center;
      text-align: center;
    }

    .frase {
      max-width: none;
    }

    .legal {
      justify-content: flex-start;
    }
  }
</style>
