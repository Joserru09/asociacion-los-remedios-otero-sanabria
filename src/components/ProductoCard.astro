---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { euros } from '../utils/fecha';

interface Props {
  producto: CollectionEntry<'productos'>;
  compacto?: boolean;
}
const { producto, compacto = false } = Astro.props;
const { nombre, precio, imagen, enlaceCompra, tallas, agotado } = producto.data;
---

<article class:list={['producto', { compacto, agotado }]}>
  <div class="foto">
    <Image src={imagen} alt={nombre} width={800} height={800} loading="lazy" />
    {agotado && <span class="etiqueta">Agotado</span>}
  </div>
  <div class="info">
    <h3>{nombre}</h3>
    <p class="precio">{euros(precio)}</p>
    {!compacto && <slot />}
    {!compacto && tallas && <p class="tallas">Tallas: {tallas.join(', ')}</p>}
    {agotado ? (
      <span class="btn btn-deshabilitado">No disponible</span>
    ) : (
      <a class="btn btn-primario" href={enlaceCompra} target="_blank" rel="noopener">Comprar</a>
    )}
  </div>
</article>

<style>
  .producto {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .foto {
    position: relative;
    border-radius: var(--radio);
    overflow: hidden;
    background: var(--fondo-suave);
  }

  .foto img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .agotado .foto img {
    filter: grayscale(0.6);
    opacity: 0.8;
  }

  .etiqueta {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: var(--tinta);
    color: #fff;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    font-size: var(--t-sm);
    font-weight: 700;
  }

  .info h3 {
    margin-bottom: 0.15rem;
  }

  .precio {
    font-size: var(--t-md);
    font-weight: 800;
    color: var(--azul);
    margin-bottom: 0.75rem;
  }

  .tallas {
    color: var(--texto-suave);
    font-size: var(--t-sm);
  }

  .info .btn {
    align-self: flex-start;
  }

  .info :global(p:not(.precio):not(.tallas)) {
    color: var(--texto-suave);
  }
</style>
