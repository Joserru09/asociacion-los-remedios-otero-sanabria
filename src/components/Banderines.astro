---
/**
 * Fila de banderines de fiesta. Es el único adorno de la web: aparece bajo la cabecera.
 * Los colores rotan entre los de la paleta.
 */
interface Props {
  class?: string;
}
const { class: clase = '' } = Astro.props;
const colores = ['var(--fucsia)', 'var(--amarillo)', 'var(--azul)', 'var(--verde)', 'var(--naranja)'];
const ancho = 44;
const n = 60;
---

<div class={`banderines ${clase}`} aria-hidden="true">
  <svg viewBox={`0 0 ${ancho * n} 40`} preserveAspectRatio="xMidYMin slice" width="100%" height="40">
    <path
      d={`M0 4 ${Array.from({ length: n }, (_, i) => `L${i * ancho + ancho / 2} ${6 + Math.sin(i * 0.9) * 2} L${(i + 1) * ancho} 4`).join(' ')}`}
      fill="none"
      stroke="var(--tinta)"
      stroke-width="1.5"
      opacity="0.35"
    />
    {Array.from({ length: n }, (_, i) => {
      const x = i * ancho;
      const y = 4 + Math.sin(i * 0.9) * 1.2;
      return (
        <path
          d={`M${x + 4} ${y} L${x + ancho - 4} ${y} L${x + ancho / 2} ${y + 30} Z`}
          fill={colores[i % colores.length]}
        />
      );
    })}
  </svg>
</div>

<style>
  .banderines {
    line-height: 0;
    overflow: hidden;
  }
</style>
