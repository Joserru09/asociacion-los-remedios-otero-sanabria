---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Adorno from '../../components/Adorno.astro';
import Icono from '../../components/Icono.astro';
import { fechaLarga, iso } from '../../utils/fecha';
import { site } from '../../site.config';

export async function getStaticPaths() {
  const noticias = (await getCollection('noticias')).sort(
    (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime(),
  );
  return noticias.map((n, i) => ({
    params: { id: n.id },
    props: {
      noticia: n,
      // La lista va de más nueva a más vieja: la "siguiente" es la anterior en el tiempo.
      masNueva: noticias[i - 1],
      masVieja: noticias[i + 1],
    },
  }));
}

const { noticia, masNueva, masVieja } = Astro.props;
const { Content } = await render(noticia);
const { titulo, fecha, resumen, imagen } = noticia.data;
const og = imagen ? new URL(imagen.src, site.url).toString() : undefined;
const enlace = new URL(Astro.url.pathname, site.url).toString();
---

<Base titulo={titulo} descripcion={resumen} imagen={og}>
  <article class="articulo">
    <header class="cabecera-articulo">
      <div class="contenedor">
        <a href="/noticias/" class="volver">
          <Icono nombre="flecha" tamano={14} class="flecha-atras" />
          Volver al tablón
        </a>
        <time datetime={iso(fecha)} class="fecha">{fechaLarga(fecha)}</time>
        <h1>{titulo}</h1>
        <Adorno tipo="filete" class="filete" />
        <p class="resumen">{resumen}</p>
      </div>
    </header>

    {
      imagen && (
        <div class="contenedor">
          <Image
            src={imagen}
            alt=""
            width={1600}
            widths={[640, 1100, 1600]}
            sizes="(max-width: 1300px) 94vw, 72rem"
            class="foto"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }

    <div class="contenedor">
      <div class="prosa columna">
        <Content />
      </div>

      <footer class="columna cierre">
        <div class="compartir">
          <p>¿Te ha servido? Pásaselo a quien no lo haya visto.</p>
          <a
            class="btn btn-verde"
            href={`https://wa.me/?text=${encodeURIComponent(`${titulo} ${enlace}`)}`}
            target="_blank"
            rel="noopener"
          >
            <Icono nombre="whatsapp" tamano={15} />
            Compartir
          </a>
        </div>

        {
          (masNueva || masVieja) && (
            <nav class="saltos" aria-label="Más noticias">
              {masVieja ? (
                <a href={`/noticias/${masVieja.id}/`} class="salto">
                  <span class="salto-rotulo">Anterior</span>
                  <span class="salto-titulo">{masVieja.data.titulo}</span>
                </a>
              ) : (
                <span />
              )}
              {masNueva && (
                <a href={`/noticias/${masNueva.id}/`} class="salto derecha">
                  <span class="salto-rotulo">Siguiente</span>
                  <span class="salto-titulo">{masNueva.data.titulo}</span>
                </a>
              )}
            </nav>
          )
        }
      </footer>
    </div>
  </article>
</Base>

<style>
  .articulo {
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .cabecera-articulo {
    background: var(--crema-2);
    border-bottom: 1px solid var(--linea);
    padding-block: clamp(1.5rem, 3.5vw, 2.5rem) clamp(2.25rem, 5vw, 3.5rem);
    text-align: center;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .volver {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    margin-bottom: 1.5rem;
  }

  .volver :global(.flecha-atras) {
    transform: rotate(180deg);
  }

  .fecha {
    display: block;
    font-size: var(--t-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tinta-suave);
    margin-bottom: 0.85rem;
  }

  .cabecera-articulo h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.35rem);
    font-weight: 400;
    line-height: 1.08;
    max-width: 22ch;
    margin-inline: auto;
  }

  .filete {
    margin: 1rem auto 0;
    width: min(200px, 65%);
  }

  .resumen {
    margin: 1.1rem auto 0;
    max-width: 54ch;
    color: var(--tinta-media);
    font-size: var(--t-md);
  }

  .foto {
    width: 100%;
    height: auto;
    max-height: 30rem;
    object-fit: cover;
    border-radius: var(--radio);
    border: 1px solid var(--linea);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .columna {
    max-width: var(--ancho-texto);
    margin-inline: auto;
  }

  .cierre {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }

  .compartir {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid var(--linea);
  }

  .compartir p {
    margin: 0;
    color: var(--tinta-media);
    font-size: var(--t-sm);
  }

  .saltos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }

  .salto {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1rem 1.15rem;
    background: var(--papel);
    border: 1px solid var(--linea);
    border-radius: var(--radio);
    text-decoration: none;
    transition: border-color 160ms ease;
  }

  .salto:hover {
    border-color: var(--verde-claro);
  }

  .salto.derecha {
    text-align: right;
  }

  .salto-rotulo {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--terracota-osc);
  }

  .salto-titulo {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--tinta);
    line-height: 1.3;
  }

  @media (max-width: 560px) {
    .saltos {
      grid-template-columns: 1fr;
    }

    .salto.derecha {
      text-align: left;
    }
  }
</style>
