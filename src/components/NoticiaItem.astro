---
/**
 * Entrada del tablón: fecha grande a la izquierda, título y resumen a la derecha.
 */
import type { CollectionEntry } from 'astro:content';
import { fechaCorta, iso } from '../utils/fecha';

interface Props {
  noticia: CollectionEntry<'noticias'>;
}
const { noticia } = Astro.props;
const f = fechaCorta(noticia.data.fecha);
const href = `/novedades/${noticia.id}/`;
---

<article class="noticia">
  <time datetime={iso(noticia.data.fecha)} class="fecha">
    <span class="dia">{f.dia}</span>
    <span class="mes">{f.mes} {f.año}</span>
  </time>
  <div class="cuerpo">
    <h3><a href={href}>{noticia.data.titulo}</a></h3>
    <p>{noticia.data.resumen}</p>
  </div>
</article>

<style>
  .noticia {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--linea);
  }

  .fecha {
    display: flex;
    flex-direction: column;
    color: var(--tinta);
    line-height: 1;
  }

  .dia {
    font-size: 2.75rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    color: var(--fucsia);
  }

  .mes {
    font-size: var(--t-sm);
    color: var(--texto-suave);
    margin-top: 0.3rem;
  }

  .cuerpo h3 {
    margin-bottom: 0.35rem;
  }

  .cuerpo h3 a {
    color: var(--tinta);
    text-decoration: none;
  }

  .cuerpo h3 a:hover {
    text-decoration: underline;
    text-decoration-color: var(--amarillo);
    text-decoration-thickness: 3px;
  }

  .cuerpo p {
    margin: 0;
    color: var(--texto-suave);
    max-width: 60ch;
  }

  @media (max-width: 560px) {
    .noticia {
      grid-template-columns: 4.5rem 1fr;
      gap: 1rem;
    }
    .dia {
      font-size: 2.25rem;
    }
  }
</style>
