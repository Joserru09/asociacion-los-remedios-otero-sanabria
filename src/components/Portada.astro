---
/** Cabecera de las páginas interiores: título grande y una entradilla. */
interface Props {
  titulo: string;
  entradilla?: string;
}
const { titulo, entradilla } = Astro.props;
---

<div class="portada">
  <div class="contenedor">
    <p class="hilo" aria-hidden="true"></p>
    <h1>{titulo}</h1>
    {entradilla && <p class="entradilla">{entradilla}</p>}
  </div>
</div>

<style>
  .portada {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(1rem, 3vw, 2rem);
  }

  .portada h1 {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    margin-bottom: 0.75rem;
  }

  .hilo {
    width: 3.5rem;
    border-top: 2px solid var(--oro);
    margin: 0 0 1.5rem;
  }

  .entradilla {
    font-size: var(--t-md);
    color: var(--texto-suave);
    max-width: 52ch;
    margin: 0;
  }
</style>
