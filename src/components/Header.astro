---
import { site, menu } from '../site.config';

const ruta = Astro.url.pathname;
const activo = (href: string) => (href === '/' ? ruta === '/' : ruta.startsWith(href));
---

<header class="cabecera">
  <div class="contenedor barra">
    <a href="/" class="marca" aria-label={`${site.nombre}, inicio`}>
      <svg viewBox="0 0 40 40" width="36" height="36" aria-hidden="true">
        <rect width="40" height="40" rx="8" fill="var(--superficie)" stroke="var(--linea)" />
        <circle cx="27" cy="13" r="4.5" fill="var(--oro)" />
        <path d="M4 32 L15 18 L21 25 L27 20 L36 32 Z" fill="none" stroke="var(--texto)" stroke-width="1.8" stroke-linejoin="round" />
      </svg>
      <span class="marca-texto">
        <span class="marca-nombre">{site.nombre}</span>
        <span class="marca-pueblo">{site.pueblo}</span>
      </span>
    </a>

    <input type="checkbox" id="menu-movil" class="solo-lectores menu-toggle" />
    <label for="menu-movil" class="menu-boton" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </label>

    <nav class="menu" aria-label="Principal">
      <ul>
        {menu.map((item) => (
          <li>
            <a href={item.href} aria-current={activo(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        <li class="menu-donar">
          <a href="/donaciones/" class="btn btn-primario" aria-current={activo('/donaciones/') ? 'page' : undefined}>Donar</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .cabecera {
    background: var(--fondo);
    border-bottom: 1px solid var(--linea);
    position: relative;
    z-index: 10;
  }

  .barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.9rem;
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--tinta);
  }

  .marca-texto {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .marca-nombre {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.15rem;
  }

  .marca-pueblo {
    font-size: var(--t-xs);
    color: var(--texto-suave);
  }

  .menu ul {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.9rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu a:not(.btn) {
    text-decoration: none;
    color: var(--texto);
    font-weight: 500;
    font-size: var(--t-sm);
    padding: 0.35rem 0;
    border-bottom: 2px solid transparent;
  }

  .menu a:not(.btn):hover {
    color: var(--oro-claro);
  }

  .menu a:not(.btn)[aria-current='page'] {
    color: var(--oro-claro);
    border-bottom-color: var(--oro);
  }

  .menu .btn {
    padding: 0.55rem 1.1rem;
    font-size: var(--t-sm);
  }

  .menu-boton {
    display: none;
  }

  @media (max-width: 880px) {
    .menu-boton {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      cursor: pointer;
      border-radius: 8px;
    }

    .menu-boton span {
      display: block;
      height: 2px;
      width: 24px;
      margin-inline: auto;
      background: var(--texto);
      border-radius: 2px;
      transition: transform 160ms ease, opacity 160ms ease;
    }

    .menu-toggle:focus-visible + .menu-boton {
      outline: 2px solid var(--oro);
    }

    .menu {
      display: none;
      position: absolute;
      inset: 100% 0 auto 0;
      background: var(--fondo);
      border-bottom: 1px solid var(--linea);
      box-shadow: 0 24px 40px -20px rgba(0, 0, 0, 0.6);
    }

    .menu ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem var(--margen) 1.25rem;
    }

    .menu li a:not(.btn) {
      display: block;
      padding: 0.9rem 0;
      border-bottom: 1px solid var(--linea);
      font-size: var(--t-md);
    }

    .menu-donar {
      padding-top: 1rem;
    }

    .menu-donar .btn {
      width: 100%;
      justify-content: center;
    }

    .menu-toggle:checked ~ .menu {
      display: block;
    }

    .menu-toggle:checked + .menu-boton span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .menu-toggle:checked + .menu-boton span:nth-child(2) {
      opacity: 0;
    }
    .menu-toggle:checked + .menu-boton span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>
