---
/**
 * Silueta de la provincia de Zamora con Otero marcado con un corazón,
 * arriba a la izquierda, que es donde queda Sanabria. Es un dibujo
 * decorativo, no un mapa a escala.
 */
interface Props {
  class?: string;
}
const { class: clase = '' } = Astro.props;
---

<figure class={`mapa ${clase}`}>
  <svg
    viewBox="0 0 160 126"
    width="160"
    height="126"
    fill="none"
    stroke="currentColor"
    stroke-width="1.1"
    stroke-linejoin="round"
    stroke-linecap="round"
    role="img"
    aria-label="Otero de Sanabria, en el noroeste de la provincia de Zamora"
  >
    <text x="152" y="16" text-anchor="end" class="rotulo-mapa">Otero de</text>
    <text x="152" y="28" text-anchor="end" class="rotulo-mapa">Sanabria</text>

    <path
      d="M16 60 L12 48 L22 36 L38 32 L48 40 L62 36 L74 42 L88 36 L102 40 L118 36 L132 44 L130 56 L140 64 L134 78 L120 86 L110 98 L94 104 L78 100 L64 106 L50 100 L38 90 L28 76 Z"
    ></path>

    <path d="M40 44 L96 30" stroke-dasharray="2 3" stroke-width="0.9" opacity="0.55"></path>

    <path
      d="M36 52.5 35.2 51.8c-2.9-2.6-4.8-4.3-4.8-6.4a3 3 0 0 1 3-3c1 0 2 .5 2.6 1.2a3.4 3.4 0 0 1 2.6-1.2 3 3 0 0 1 3 3c0 2.1-1.9 3.8-4.8 6.4l-.8.7z"
      fill="currentColor"
      stroke="none"
    ></path>
  </svg>
</figure>

<style>
  .mapa {
    margin: 0;
  }

  .mapa svg {
    width: 100%;
    max-width: 11rem;
    height: auto;
    opacity: 0.95;
  }

  .rotulo-mapa {
    font-family: var(--sans);
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    fill: currentColor;
    stroke: none;
  }
</style>
