---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';

interface Props {
  titulo: string;
  descripcion?: string;
  /** URL absoluta de la imagen para compartir en redes */
  imagen?: string;
}

const { titulo, descripcion = site.descripcion, imagen } = Astro.props;
const tituloCompleto = titulo === site.nombre ? `${site.nombre}, ${site.pueblo}` : `${titulo} · ${site.nombre}`;
const canonical = new URL(Astro.url.pathname, site.url);
const og = imagen ?? new URL('/og.png', site.url).toString();

const datos = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.nombreLargo,
  alternateName: site.nombre,
  url: site.url,
  email: site.email,
  telephone: `+34 ${site.telefono}`,
  foundingDate: String(site.fundacion),
  description: site.descripcion,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.direccion,
    postalCode: site.codigoPostal,
    addressRegion: site.provincia,
    addressCountry: 'ES',
  },
};
---

<!doctype html>
<html lang={site.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`Noticias de ${site.nombre}`} href="/rss.xml" />
    <meta name="theme-color" content="#fbf7ed" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(datos)} />
  </head>
  <body>
    <a href="#contenido" class="saltar">Ir al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    background: var(--terracota);
    color: #fff;
    padding: 0.7rem 1.2rem;
    border-radius: 0 0 3px 3px;
    text-decoration: none;
    font-weight: 600;
    font-size: var(--t-sm);
  }

  .saltar:focus {
    top: 0;
    color: #fff;
  }
</style>
