---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import NoticiaCard from '../components/NoticiaCard.astro';
import ProductoCard from '../components/ProductoCard.astro';
import PanelSocio from '../components/PanelSocio.astro';
import Adorno from '../components/Adorno.astro';
import Redes from '../components/Redes.astro';
import Icono from '../components/Icono.astro';
import { site, redesActivas, whatsappActivo } from '../site.config';
import { galeria } from '../data/galeria';
import hero from '../assets/hero.jpg';

const noticias = (await getCollection('noticias')).sort(
  (a, b) => b.data.fecha.getTime() - a.data.fecha.getTime(),
);
const destacadas = [...noticias].sort(
  (a, b) => Number(b.data.destacada) - Number(a.data.destacada) || b.data.fecha.getTime() - a.data.fecha.getTime(),
);
const ultimas = destacadas.slice(0, 3);

const productos = (await getCollection('productos'))
  .sort((a, b) => Number(a.data.agotado) - Number(b.data.agotado) || a.data.orden - b.data.orden)
  .slice(0, 4);

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/galeria/*.{jpg,jpeg,png,webp}', {
  eager: true,
});
const muestra = galeria.slice(0, 6).map((g) => ({
  ...g,
  src: fotos[`../assets/galeria/${g.fichero}`].default,
}));

const canal = whatsappActivo();
---

<Base titulo={site.nombre}>
  {/* ---------------- Portada ---------------- */}
  <section class="hero">
    <Image
      src={hero}
      alt=""
      width={2000}
      widths={[640, 1100, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="hero-foto"
      style={`object-position: ${site.heroFoco}`}
    />
    <div class="hero-velo" aria-hidden="true"></div>
    <div class="contenedor hero-dentro">
      <h1>Bienvenidos a<br />{site.pueblo}</h1>
      <Adorno tipo="filete" class="hero-filete" />
      <p class="hero-lema">{site.lema}</p>
      <div class="hero-botones">
        <a class="btn btn-terracota" href="/noticias/">
          <Icono nombre="calendario" tamano={15} />
          Ver novedades
        </a>
        <a class="btn btn-verde" href="/donaciones/">
          <Icono nombre="manos" tamano={16} />
          Colaborar
        </a>
      </div>
    </div>
  </section>

  {/* ---------------- Tablón de novedades + hazte socio ---------------- */}
  <section class="seccion tablon-seccion">
    <div class="contenedor tablon-rejilla">
      <div class="tablon">
        <TituloSeccion titulo="Tablón de novedades" />
        <div class="tablon-cartas">
          {ultimas.map((n) => <NoticiaCard noticia={n} />)}
        </div>
        <p class="tablon-pie">
          <a href="/noticias/" class="enlace-flecha">Todas las noticias</a>
        </p>
      </div>
      <PanelSocio />
    </div>
  </section>

  {/* ---------------- Tienda solidaria | Galería ---------------- */}
  <section class="dos-mitades">
    <div class="mitad mitad-tienda">
      <div class="dentro">
        <TituloSeccion
          titulo="Tienda solidaria"
          entradilla="Cada compra ayuda a financiar nuestras actividades."
        />
        <div class="productos">
          {productos.map((p) => <ProductoCard producto={p} compacto />)}
        </div>
        <div class="centrar">
          <a class="btn btn-linea" href="/tienda/">
            Ver todos los productos
            <Icono nombre="bolsa" tamano={14} />
          </a>
        </div>
      </div>
    </div>

    <div class="mitad mitad-galeria">
      <div class="dentro">
        <TituloSeccion titulo="Galería" />
        <div class="mosaico">
          {
            muestra.map((f) => (
              <a href="/galeria/" class="mosaico-foto" aria-label={`Galería: ${f.pie}`}>
                <Image
                  src={f.src}
                  alt={f.pie}
                  width={600}
                  widths={[280, 600]}
                  sizes="(max-width: 700px) 30vw, 15rem"
                  loading="lazy"
                />
              </a>
            ))
          }
        </div>
        <div class="centrar">
          <a href="/galeria/" class="enlace-flecha">Ver más fotos</a>
        </div>
        <Adorno tipo="iglesia" class="iglesia-galeria" />
      </div>
    </div>
  </section>

  {/* ---------------- Redes | WhatsApp ---------------- */}
  {
    (redesActivas().length > 0 || canal) && (
      <section class="seccion-calida comunidad">
        <Adorno tipo="iglesia" class="iglesia-comunidad" />
        <div class="contenedor comunidad-rejilla">
          {redesActivas().length > 0 && (
            <div class="bloque">
              <h2 class="titulo-bloque">Redes sociales</h2>
              <p>Síguenos y mantente al día de todo lo que ocurre en {site.pueblo}.</p>
              <Redes class="redes-portada" />
            </div>
          )}

          {redesActivas().length > 0 && canal && <Adorno tipo="ramo" class="ramo-comunidad" />}

          {canal && (
            <div class="bloque">
              <h2 class="titulo-bloque">
                <span class="circulo-whatsapp">
                  <Icono nombre="whatsapp" tamano={22} />
                </span>
                WhatsApp comunidad
              </h2>
              <p>Únete a nuestro canal de WhatsApp y recibe avisos, actividades, novedades y mucho más.</p>
              <a class="btn btn-verde" href={canal} target="_blank" rel="noopener">
                <Icono nombre="whatsapp" tamano={15} />
                Unirme al canal
              </a>
            </div>
          )}
        </div>
      </section>
    )
  }
</Base>

<style>
  /* ---------------- Portada ---------------- */

  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: clamp(23rem, 54vh, 33rem);
    overflow: hidden;
    background: var(--verde);
  }

  .hero :global(.hero-foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* El punto de enfoque se fija desde site.config.ts (site.heroFoco). */
  }

  .hero-velo {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        100deg,
        rgba(31, 38, 21, 0.85) 0%,
        rgba(31, 38, 21, 0.62) 32%,
        rgba(31, 38, 21, 0.2) 58%,
        rgba(31, 38, 21, 0.02) 78%
      ),
      linear-gradient(to top, rgba(31, 38, 21, 0.4), transparent 45%);
  }

  .hero-dentro {
    position: relative;
    padding-block: clamp(3rem, 7vw, 4.5rem);
    max-width: min(var(--ancho), 100% - 2 * var(--margen));
  }

  .hero h1 {
    margin: 0;
    color: #fff;
    font-size: var(--t-hero);
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: 0.005em;
    text-shadow: 0 2px 24px rgba(20, 26, 12, 0.4);
  }

  .hero :global(.hero-filete) {
    margin: 1.1rem 0 1.35rem;
    width: min(240px, 80%);
    color: rgba(255, 255, 255, 0.75);
  }

  .hero-lema {
    max-width: 26ch;
    margin: 0 0 1.85rem;
    color: rgba(255, 255, 255, 0.94);
    font-size: clamp(1.02rem, 1.9vw, 1.2rem);
    line-height: 1.5;
    text-shadow: 0 1px 14px rgba(20, 26, 12, 0.45);
  }

  .hero-botones {
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  /* ---------------- Tablón ---------------- */

  .tablon-seccion {
    background: var(--crema);
  }

  .tablon-rejilla {
    display: grid;
    grid-template-columns: minmax(0, 2.15fr) minmax(17rem, 1fr);
    gap: clamp(1.75rem, 3.5vw, 3rem);
    align-items: stretch;
  }

  .tablon {
    display: flex;
    flex-direction: column;
  }

  .tablon-cartas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13.5rem, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .tablon-pie {
    margin: 1.5rem 0 0;
    text-align: center;
  }

  @media (max-width: 1000px) {
    .tablon-rejilla {
      grid-template-columns: 1fr;
    }
  }

  /* ---------------- Dos mitades: tienda y galería ---------------- */

  .dos-mitades {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(26rem, 100%), 1fr));
  }

  .mitad {
    display: flex;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .mitad-tienda {
    background: var(--crema-3);
    justify-content: flex-end;
  }

  .mitad-galeria {
    background: var(--crema);
    justify-content: flex-start;
  }

  .dentro {
    position: relative;
    width: 100%;
    max-width: calc(var(--ancho) / 2);
    padding-inline: clamp(1.25rem, 3.5vw, 3rem);
  }

  .productos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(6.5rem, 100%), 1fr));
    gap: clamp(0.75rem, 1.6vw, 1.15rem);
    margin-bottom: 1.75rem;
  }

  .centrar {
    display: flex;
    justify-content: center;
  }

  .mosaico {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .mosaico-foto {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: 3px;
    overflow: hidden;
    border: 1px solid var(--linea);
    background: var(--crema-3);
  }

  .mosaico-foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .mosaico-foto:hover :global(img) {
    transform: scale(1.05);
  }

  .mitad :global(.iglesia-galeria) {
    position: absolute;
    right: clamp(0.5rem, 2vw, 1.5rem);
    bottom: -2.75rem;
    width: 8.5rem;
    opacity: 0.32;
    pointer-events: none;
  }

  /* ---------------- Comunidad ---------------- */

  .comunidad {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 5vw, 3.75rem);
    border-top: 1px solid var(--linea);
  }

  .comunidad :global(.iglesia-comunidad) {
    position: absolute;
    right: 2%;
    bottom: -1.5rem;
    width: 11rem;
    opacity: 0.3;
    pointer-events: none;
  }

  .comunidad-rejilla {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(1.75rem, 4vw, 3.5rem);
  }

  .bloque p {
    color: var(--tinta-media);
    max-width: 42ch;
    margin-bottom: 1.35rem;
    font-size: var(--t-sm);
  }

  .titulo-bloque {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0 0 0.65rem;
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(1.25rem, 2.4vw, 1.7rem);
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .circulo-whatsapp {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    flex: none;
  }

  .comunidad :global(.ramo-comunidad) {
    width: 3.5rem;
    opacity: 0.55;
    justify-self: center;
  }

  @media (max-width: 900px) {
    .comunidad-rejilla {
      grid-template-columns: 1fr;
    }

    .comunidad :global(.ramo-comunidad) {
      display: none;
    }

    .comunidad :global(.iglesia-comunidad) {
      opacity: 0.16;
    }
  }
</style>
