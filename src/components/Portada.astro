---
/** Cabecera de las páginas interiores: título centrado con el filete de hojas debajo. */
import Adorno from './Adorno.astro';

interface Props {
  titulo: string;
  entradilla?: string;
  rotulo?: string;
}
const { titulo, entradilla, rotulo } = Astro.props;
---

<div class="portada">
  <div class="contenedor">
    {rotulo && <p class="rotulo">{rotulo}</p>}
    <h1>{titulo}</h1>
    <Adorno tipo="filete" class="filete" />
    {entradilla && <p class="entradilla">{entradilla}</p>}
  </div>
</div>

<style>
  .portada {
    background: var(--crema-2);
    border-bottom: 1px solid var(--linea);
    padding-block: clamp(2.5rem, 5.5vw, 4.25rem);
    text-align: center;
  }

  .portada h1 {
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    font-weight: 400;
    margin: 0;
    line-height: 1.08;
  }

  .filete {
    margin: 1.1rem auto 0;
    width: min(220px, 70%);
    color: var(--verde-claro);
  }

  .entradilla {
    margin: 1.15rem auto 0;
    max-width: 56ch;
    color: var(--tinta-media);
    font-size: var(--t-md);
  }
</style>
