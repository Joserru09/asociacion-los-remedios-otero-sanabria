---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icono from './Icono.astro';
import { euros } from '../utils/fecha';

interface Props {
  producto: CollectionEntry<'productos'>;
  /** Versión reducida para la portada: solo foto, nombre y precio. */
  compacto?: boolean;
}
const { producto, compacto = false } = Astro.props;
const { nombre, precio, imagen, enlaceCompra, tallas, agotado } = producto.data;
const anchos = compacto ? [220, 440] : [320, 640];
const medidas = compacto
  ? '(max-width: 600px) 45vw, 12rem'
  : '(max-width: 600px) 92vw, (max-width: 1000px) 44vw, 18rem';
---

<article class:list={['producto', { compacto, agotado }]}>
  <a class="foto" href={agotado ? undefined : enlaceCompra} target={agotado ? undefined : '_blank'} rel="noopener" tabindex={agotado ? -1 : undefined}>
    <Image src={imagen} alt={nombre} width={640} widths={anchos} sizes={medidas} loading="lazy" />
    {agotado && <span class="etiqueta">Agotado</span>}
  </a>

  <div class="info">
    <h3>{nombre}</h3>
    <p class="precio">{euros(precio)}</p>
    {!compacto && <div class="descripcion"><slot /></div>}
    {!compacto && tallas && <p class="tallas">Tallas: {tallas.join(', ')}</p>}
    {
      !compacto &&
        (agotado ? (
          <span class="btn btn-agotado">No disponible</span>
        ) : (
          <a class="btn btn-verde" href={enlaceCompra} target="_blank" rel="noopener">
            Comprar
            <Icono nombre="bolsa" tamano={14} />
          </a>
        ))
    }
    {!compacto && <p class="envio">Envío a casa o recogida gratis en el pueblo.</p>}
  </div>
</article>

<style>
  .producto {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 0.85rem;
  }

  .foto {
    position: relative;
    display: block;
    border-radius: var(--radio);
    overflow: hidden;
    background: var(--papel);
    border: 1px solid var(--linea);
    transition: border-color 180ms ease;
  }

  .foto:hover {
    border-color: var(--verde-claro);
  }

  .foto :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .foto:hover :global(img) {
    transform: scale(1.03);
  }

  .agotado .foto :global(img) {
    filter: grayscale(0.65);
    opacity: 0.6;
  }

  .etiqueta {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    background: var(--crema);
    border: 1px solid var(--linea);
    color: var(--tinta-media);
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .info {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.15rem;
  }

  .info h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
  }

  .precio {
    font-family: var(--sans);
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--terracota-osc);
    margin: 0;
  }

  .descripcion {
    margin-top: 0.5rem;
    flex: 1;
  }

  .descripcion :global(p) {
    color: var(--tinta-media);
    font-size: var(--t-sm);
    line-height: 1.6;
    margin: 0 0 0.6em;
  }

  .tallas {
    color: var(--tinta-suave);
    font-size: var(--t-sm);
    margin: 0 0 0.9rem;
  }

  .info .btn {
    align-self: flex-start;
    margin-top: auto;
  }

  .envio {
    margin: 0.6rem 0 0;
    font-size: var(--t-xs);
    color: var(--tinta-suave);
  }

  /* Versión de la portada: centrada y sin más adornos. */
  .compacto {
    gap: 0.6rem;
    text-align: center;
  }

  .compacto .info {
    gap: 0;
  }

  /* El nombre ocupa el hueco sobrante para que los precios queden a la misma altura. */
  .compacto .info h3 {
    flex: 1;
  }

  .compacto .info h3 {
    font-size: 0.92rem;
    font-family: var(--sans);
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .compacto .precio {
    font-size: 0.95rem;
    margin-top: 0.15rem;
  }
</style>
