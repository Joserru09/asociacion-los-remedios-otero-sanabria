---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';

interface Props {
  titulo: string;
  descripcion?: string;
  /** URL absoluta de la imagen para compartir en redes */
  imagen?: string;
}

const { titulo, descripcion = site.descripcion, imagen } = Astro.props;
const tituloCompleto = titulo === site.nombre ? `${site.nombre}, ${site.pueblo}` : `${titulo} · ${site.nombre}`;
const canonical = new URL(Astro.url.pathname, site.url);
const og = imagen ?? new URL('/og.png', site.url).toString();
---

<!doctype html>
<html lang={site.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`Novedades de ${site.nombre}`} href="/rss.xml" />
    <meta name="theme-color" content="#12161e" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a href="#contenido" class="saltar">Ir al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .saltar {
    position: absolute;
    left: 1rem;
    top: -4rem;
    background: var(--oro);
    color: var(--oro-tinta);
    padding: 0.6rem 1rem;
    border-radius: 0 0 0.5rem 0.5rem;
    z-index: 100;
    text-decoration: none;
    font-weight: 600;
  }

  .saltar:focus {
    top: 0;
  }
</style>
