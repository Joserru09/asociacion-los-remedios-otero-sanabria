---
import { site, menu } from '../site.config';
import Banderines from './Banderines.astro';

const ruta = Astro.url.pathname;
const activo = (href: string) => (href === '/' ? ruta === '/' : ruta.startsWith(href));
---

<header class="cabecera">
  <div class="contenedor barra">
    <a href="/" class="marca" aria-label={`${site.nombre}, inicio`}>
      <svg viewBox="0 0 40 40" width="40" height="40" aria-hidden="true">
        <circle cx="20" cy="20" r="20" fill="var(--azul)" />
        <path d="M6 27 Q20 10 34 27 Z" fill="var(--verde)" />
        <circle cx="28" cy="13" r="4" fill="var(--amarillo)" />
        <rect x="6" y="27" width="28" height="7" rx="2" fill="var(--fucsia)" />
      </svg>
      <span class="marca-texto">
        <span class="marca-nombre">{site.nombre}</span>
        <span class="marca-pueblo">{site.pueblo}</span>
      </span>
    </a>

    <input type="checkbox" id="menu-movil" class="solo-lectores menu-toggle" />
    <label for="menu-movil" class="menu-boton" aria-label="Abrir menú">
      <span></span><span></span><span></span>
    </label>

    <nav class="menu" aria-label="Principal">
      <ul>
        {menu.map((item) => (
          <li>
            <a href={item.href} aria-current={activo(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
        <li class="menu-donar">
          <a href="/donaciones/" class="btn btn-primario" aria-current={activo('/donaciones/') ? 'page' : undefined}>Donar</a>
        </li>
      </ul>
    </nav>
  </div>
  <Banderines />
</header>

<style>
  .cabecera {
    background: var(--fondo);
    position: relative;
    z-index: 10;
  }

  .barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1rem;
  }

  .marca {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--tinta);
  }

  .marca-texto {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .marca-nombre {
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }

  .marca-pueblo {
    font-size: var(--t-xs);
    color: var(--texto-suave);
  }

  .menu ul {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .menu a:not(.btn) {
    text-decoration: none;
    color: var(--tinta);
    font-weight: 600;
    padding: 0.35rem 0;
    border-bottom: 3px solid transparent;
  }

  .menu a:not(.btn):hover,
  .menu a:not(.btn)[aria-current='page'] {
    border-bottom-color: var(--amarillo);
  }

  .menu .btn {
    padding: 0.6rem 1.2rem;
    font-size: var(--t-sm);
  }

  .menu-boton {
    display: none;
  }

  @media (max-width: 860px) {
    .menu-boton {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      cursor: pointer;
      border-radius: 10px;
    }

    .menu-boton span {
      display: block;
      height: 3px;
      width: 26px;
      margin-inline: auto;
      background: var(--tinta);
      border-radius: 2px;
      transition: transform 160ms ease, opacity 160ms ease;
    }

    .menu-toggle:focus-visible + .menu-boton {
      outline: 3px solid var(--amarillo);
    }

    .menu {
      display: none;
      position: absolute;
      inset: 100% 0 auto 0;
      background: var(--fondo);
      border-top: 1px solid var(--linea);
      box-shadow: 0 18px 30px -20px rgba(20, 33, 61, 0.4);
    }

    .menu ul {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem var(--margen) 1.25rem;
    }

    .menu li a:not(.btn) {
      display: block;
      padding: 0.9rem 0;
      border-bottom: 1px solid var(--linea);
      font-size: var(--t-md);
    }

    .menu li a:not(.btn)[aria-current='page'] {
      color: var(--fucsia);
    }

    .menu-donar {
      padding-top: 1rem;
    }

    .menu-donar .btn {
      width: 100%;
      justify-content: center;
    }

    .menu-toggle:checked ~ .menu {
      display: block;
    }

    .menu-toggle:checked + .menu-boton span:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
    }
    .menu-toggle:checked + .menu-boton span:nth-child(2) {
      opacity: 0;
    }
    .menu-toggle:checked + .menu-boton span:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
    }
  }
</style>
